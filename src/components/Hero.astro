---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section
  class="relative my-8 overflow-hidden rounded-3xl border border-white/10 px-6 py-20 sm:px-10 md:py-28"
  id="hero"
>
  <div
    class="absolute inset-0 -z-10 bg-cover bg-center bg-no-repeat"
    style="background-image: linear-gradient(135deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.72) 50%, rgba(0, 0, 0, 0.6) 100%), url('/hero-bg.avif');"
  >
  </div>
  <div class="relative z-10">
    <h1
      class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
    >
      {name}
    </h1>
    <p
      class="mb-9 font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
    >
      {specialty}
    </p>
    <p class="mb-16 text-base font-normal text-neutral md:text-lg">
      {summary}
    </p>

    <button
      type="button"
      id="contact-btn"
      class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff] shadow-lg shadow-primary/25 transition-all hover:brightness-110 cursor-pointer"
    >
      Get in Touch
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>
</section>

<!-- Contact Modal -->
<div
  id="contact-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <div
    id="contact-modal-box"
    class="relative w-full max-w-md rounded-2xl border border-white/10 bg-[#161a22] p-6 text-white shadow-2xl transition-transform duration-200 scale-95"
  >
    <div class="mb-5 flex items-center justify-between border-b border-white/10 pb-4">
      <div>
        <h2 id="contact-modal-title" class="text-xl font-semibold text-white">Get in Touch</h2>
        <p class="text-xs text-neutral mt-0.5">Reach out directly through any channel below:</p>
      </div>
      <button
        type="button"
        id="contact-modal-close"
        class="rounded-lg p-1.5 text-neutral hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <div class="space-y-3">
      <!-- Email -->
      <div class="flex items-center justify-between rounded-xl border border-white/5 bg-black/40 p-3.5 transition-colors hover:border-white/15">
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs text-neutral">Email</div>
            <div class="text-sm font-medium text-white truncate">{email}</div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            class="copy-contact-btn rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-neutral hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
            data-copy={email}
          >
            Copy
          </button>
          <a
            href={`mailto:${email}`}
            class="rounded-md bg-primary px-3 py-1 text-xs font-medium text-white hover:brightness-110 transition-all"
          >
            Open
          </a>
        </div>
      </div>

      <!-- Phone -->
      <div class="flex items-center justify-between rounded-xl border border-white/5 bg-black/40 p-3.5 transition-colors hover:border-white/15">
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs text-neutral">Phone</div>
            <div class="text-sm font-medium text-white truncate">0919778519</div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            class="copy-contact-btn rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-neutral hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
            data-copy="0919778519"
          >
            Copy
          </button>
          <a
            href="tel:0919778519"
            class="rounded-md bg-primary px-3 py-1 text-xs font-medium text-white hover:brightness-110 transition-all"
          >
            Call
          </a>
        </div>
      </div>

      <!-- Telegram -->
      <div class="flex items-center justify-between rounded-xl border border-white/5 bg-black/40 p-3.5 transition-colors hover:border-white/15">
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs text-neutral">Telegram</div>
            <div class="text-sm font-medium text-white truncate">@Yabsera_1</div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            class="copy-contact-btn rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-neutral hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
            data-copy="@Yabsera_1"
          >
            Copy
          </button>
          <a
            href="https://t.me/Yabsera_1"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md bg-primary px-3 py-1 text-xs font-medium text-white hover:brightness-110 transition-all"
          >
            Chat
          </a>
        </div>
      </div>

      <!-- Twitter / X -->
      <div class="flex items-center justify-between rounded-xl border border-white/5 bg-black/40 p-3.5 transition-colors hover:border-white/15">
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs text-neutral">Twitter / X</div>
            <div class="text-sm font-medium text-white truncate">@Yabseramas</div>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <a
            href="https://x.com/Yabseramas"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md bg-primary px-3 py-1 text-xs font-medium text-white hover:brightness-110 transition-all"
          >
            Open
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const contactBtn = document.getElementById("contact-btn");
  const modal = document.getElementById("contact-modal");
  const modalBox = document.getElementById("contact-modal-box");
  const closeBtn = document.getElementById("contact-modal-close");

  function openModal() {
    if (!modal || !modalBox) return;
    modal.classList.remove("opacity-0", "pointer-events-none");
    modal.classList.add("opacity-100", "pointer-events-auto");
    modalBox.classList.remove("scale-95");
    modalBox.classList.add("scale-100");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal || !modalBox) return;
    modal.classList.remove("opacity-100", "pointer-events-auto");
    modal.classList.add("opacity-0", "pointer-events-none");
    modalBox.classList.remove("scale-100");
    modalBox.classList.add("scale-95");
    document.body.style.overflow = "";
  }

  contactBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  document.querySelectorAll(".copy-contact-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const textToCopy = btn.getAttribute("data-copy");
      if (!textToCopy) return;
      try {
        await navigator.clipboard.writeText(textToCopy);
        const originalText = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.add("text-primary");
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove("text-primary");
        }, 2000);
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  });
</script>
