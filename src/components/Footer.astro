---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-neutral/20 px-5 pt-6 pb-8 text-center text-white"
>
  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => {
        const isExternal = href.startsWith("http");
        return (
          <li>
            <a
              href={href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              class={`inline-block px-4 py-3 transition-colors hover:text-primary ${
                isExternal
                  ? "after:relative after:-bottom-1 after:content-[url(/external.svg)]"
                  : ""
              }`}
            >
              {text}
            </a>
          </li>
        );
      })
    }
  </ul>
  <p class="text-xs text-neutral">
    {author} © {currentYear}
  </p>
</footer>
